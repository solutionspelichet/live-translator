{
  "expo": {
    "name": "DualCast Translate",
    "slug": "dualcast-translate",
    "scheme": "dualcast",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dualcast.translate",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DualCast capte la voix des interlocuteurs pour la traduire en temps réel.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.dualcast.translate",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "DualCast capte la voix des interlocuteurs pour la traduire en temps réel.",
          "iosBackgroundMode": true,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE",
            "android.permission.POST_NOTIFICATIONS"
          ],
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback",
            "microphone"
          ]
        }
      ],
      "expo-build-properties",
      "expo-secure-store"
    ]
  }
}
