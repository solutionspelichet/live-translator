# Copy to `.env` (git-ignored) and fill in. Restart Metro with `npx expo start -c` after any change.
#
# WARNING: every EXPO_PUBLIC_* variable is INLINED in the JS bundle and readable by anyone
# who has the app. Fine for local dev / prototypes; for a published app, point the *_BASE_URL
# variables below to your own proxy that holds the real keys server-side.

EXPO_PUBLIC_DEEPGRAM_API_KEY=
EXPO_PUBLIC_DEEPL_API_KEY=
EXPO_PUBLIC_ELEVENLABS_API_KEY=

# DeepL Free keys end with ":fx" and use api-free.deepl.com; Pro keys use api.deepl.com
EXPO_PUBLIC_DEEPL_BASE_URL=
EXPO_PUBLIC_DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen
EXPO_PUBLIC_ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ElevenLabs voice ids (any multilingual voice works with eleven_turbo_v2_5)
EXPO_PUBLIC_ELEVENLABS_VOICE_A=
EXPO_PUBLIC_ELEVENLABS_VOICE_B=

# Facultatif : comptes rendus de réunion (https://openrouter.ai/keys)
EXPO_PUBLIC_OPENROUTER_API_KEY=
